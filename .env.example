# Cyber Town — 环境变量模板
# 复制为 .env 并修改

# LLM (任何 OpenAI 兼容 API — Ollama / DeepSeek / 通义千问 等)
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_ID=qwen3:8b

# Embedding 模型路径（留空则自动从 HuggingFace 下载 BAAI/bge-small-zh-v1.5）
EMBEDDING_MODEL_PATH=

# 记忆 / 模拟
MEMORY_CAPACITY=10
TOWN_TICK_SECONDS=300
